{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "collegeos": {
      "type": "streamable-http",
      "url": "https://collegeos.app/api/family-guide/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": ["openid", "profile", "email", "offline_access"]
          }
        }
      }
    }
  }
}
